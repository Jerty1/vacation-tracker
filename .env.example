# Optional: copy to .env and export variables yourself; Django does not load it.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Europe/Moscow
# DJANGO_SECRET_KEY must be set if DJANGO_DEBUG=false.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(64))"
# DJANGO_SECRET_KEY=

# SQLite is used by default, no database setup required.
DB_ENGINE=sqlite
# For PostgreSQL, set DB_ENGINE=postgresql and configure your own credentials:
# POSTGRES_DB=vacations
# POSTGRES_USER=vacations
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
